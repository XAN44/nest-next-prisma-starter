{
  "name": "monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "nest-backend",
    "next-frontend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=nest-backend",
    "dev:frontend": "npm run dev --workspace=next-frontend",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
